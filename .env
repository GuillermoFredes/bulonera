# ============================================================
# BULONERA AMYSO — Variables de entorno
# Copiar este archivo como .env y completar con valores reales.
# NUNCA subir el archivo .env al repositorio.
# ============================================================

# --- Servidor ---
PORT=3001
NODE_ENV=development

# --- Base de datos MySQL/MariaDB ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=admin
DB_NAME=bulonera_amyso

# --- JWT ---
# Generar una clave segura con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_clave_segura_muy_larga
JWT_EXPIRES_IN=8h

# --- CORS (en producción poner el dominio real) ---
CORS_ORIGIN=http://localhost:3000
